DB_HOST=          # host del servidor MySQL/MariaDB (normalmente "localhost")
DB_USER=          # usuario de MySQL con el que se conecta la API (creado por database/03_usuario_aplicacion.sql; no usar root)
DB_PASSWORD=      # contraseña de ese usuario de MySQL
DB_NAME=bdiedlavictoria    # nombre de la base de datos; debe coincidir con database/script.sql, no cambiarlo
DB_PORT=          # puerto de MySQL/MariaDB (normalmente 3306)
PORT=4000         # puerto en el que corre este backend
# Origen(es) permitidos por CORS, separados por comas (opcional)
# CORS_ORIGIN=http://localhost:5173
